# Optional. Use these instead of ~/.config/gsc-mcp/credentials.json.
# Create a Desktop app OAuth client in Google Cloud Console with the
# Google Search Console API enabled.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=

# Optional. Override where credentials.json and token.json live.
# GSC_CONFIG_DIR=~/.config/gsc-mcp

# Optional. Supply an access token minted elsewhere (gcloud, CI) and skip
# the cached-token flow entirely.
# GSC_ACCESS_TOKEN=

# Optional. Point at a different API host. Used by the test suite.
# GSC_API_BASE=https://searchconsole.googleapis.com
