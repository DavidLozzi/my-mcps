# Optional. Relocate where accounts.json lives.
# Defaults to the .credentials/ directory beside this file.
# ZOHO_CONFIG_DIR=

# Optional. Default hosts for accounts that do not set imapHost/smtpHost.
# Personal @zoho.com: imap.zoho.com / smtp.zoho.com (the defaults)
# Custom-domain (organization) mailboxes: imappro.zoho.com / smtppro.zoho.com
# Other data centers: imap.zoho.eu, imap.zoho.in, imap.zoho.com.au, ... (and smtp.*)
# ZOHO_IMAP_HOST=imap.zoho.com
# ZOHO_SMTP_HOST=smtp.zoho.com

# Test suite only — accepts the mock servers' self-signed certificate.
# Never set this for real use.
# ZOHO_TEST_INSECURE_TLS=1
