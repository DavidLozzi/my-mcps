{
  "name": "zoho-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for Zoho Mail over IMAP and SMTP — read, search, organize, send",
  "type": "module",
  "bin": {
    "zoho-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "auth": "npm run build && node dist/auth-cli.js",
    "dev": "tsc --watch",
    "test": "npm run build && node test/smoke.mjs && node test/lib.mjs && node test/e2e.mjs",
    "test:live": "npm run build && node test/live.mjs",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "senders": "npm run build --silent && node dist/senders-cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.5",
    "hoodiecrow-imap": "^3.3.1",
    "smtp-server": "^3.21.3",
    "typescript": "^5.9.3"
  }
}
