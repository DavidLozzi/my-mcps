# Optional. Use these instead of .credentials/credentials.json.
# Create a Desktop app OAuth client in Google Cloud Console with the
# AdSense Management API enabled. The client already used for ga4/gsc works.
ADSENSE_CLIENT_ID=
ADSENSE_CLIENT_SECRET=

# Optional. Relocate where credentials.json and token.json live.
# Defaults to the .credentials/ directory beside this file.
# ADSENSE_CONFIG_DIR=

# Optional. Supply an access token minted elsewhere (gcloud, CI) and skip
# the cached-token flow entirely.
# ADSENSE_ACCESS_TOKEN=

# Optional. Point at a different API host. Used by the test suite.
# ADSENSE_API_BASE=https://adsense.googleapis.com
